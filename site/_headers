# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
#
# Every page carries one inline <script type="application/ld+json">. Each is
# allow-listed below by SHA-256 so script-src stays strict — no 'unsafe-inline'.
# The hashes are derived from the page bodies, so after editing any JSON-LD
# (or re-running tools/build-service-pages.py) refresh them with:
#
#   python3 tools/refresh-csp.py

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-MOM2mTmMYfubl1MD6y94JTIhSS3oXdY5ecxmC57YlfE=' 'sha256-PM6FKtOHoUuZWrY32OV5nEZOfJ1YW252yMMUuqnPeRA=' 'sha256-Yz9dMdM4vCNob3Gn0FtiZeh8xgGU6obFO/UAj3ozJSc=' 'sha256-cpeBLj4VeKUqafdQkWEy2LGmtWfPn4tcYs9suBI278c=' 'sha256-eIvtDua2W5nfb+G6PhAEl07QRQmGwPYd+YOPGcG6Jf4=' 'sha256-ia4z2L30/mhdi/FmMMvc6T3+oHw+6EhW/qFE0+3h0TY=' 'sha256-nKHQQfnNCkdUMqLmyADfyaqTullrHMFck7EOwWdUA/E='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate
